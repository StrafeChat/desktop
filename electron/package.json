{
  "name": "strafe",
  "productName": "Strafe",
  "version": "1.3.2",
  "private": true,
  "description": "Strafe for Linux: the web client on Chromium, so calls run on a real WebRTC engine",
  "license": "AGPL-3.0",
  "author": "StrafeChat",
  "homepage": "https://strafe.chat",
  "repository": "github:StrafeChat/desktop",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "STRAFE_URL=http://localhost:3000 electron .",
    "test": "node --test \"test/**/*.test.*\"",
    "build:web": "npm --prefix ../web run build",
    "build": "electron-builder --linux -c.extraMetadata.version=$(node -p \"require('../package.json').version\")",
    "build:appimage": "electron-builder --linux AppImage -c.extraMetadata.version=$(node -p \"require('../package.json').version\")",
    "build:deb": "electron-builder --linux deb -c.extraMetadata.version=$(node -p \"require('../package.json').version\")",
    "build:rpm": "electron-builder --linux rpm -c.extraMetadata.version=$(node -p \"require('../package.json').version\")",
    "build:dir": "electron-builder --linux dir -c.extraMetadata.version=$(node -p \"require('../package.json').version\")"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.17.0"
  }
}
