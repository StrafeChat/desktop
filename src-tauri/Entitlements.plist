<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Applied when the macOS bundle is code-signed (bundle.macOS.entitlements in tauri.conf.json).
  Tauri signs with the hardened runtime by default, and under it the microphone and the camera
  stay off unless these are present - whatever Info.plist says and whatever the person answers.
  The CI build is not signed with an Apple identity today, so these do nothing yet; they are
  here so that adding one does not quietly take calls' audio and video away again.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.device.camera</key>
	<true/>
</dict>
</plist>
