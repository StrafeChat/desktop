+uint32_t RealtimeOutgoingMediaSourceGStreamer::ssrc()
+{
+    if (!m_ssrc && m_ssrcGenerator) {
+        auto candidate = m_ssrcGenerator->generateSSRC();
+        if (candidate != std::numeric_limits<uint32_t>::max())
+            m_ssrc = candidate;
+    }
+    return m_ssrc;
+}
