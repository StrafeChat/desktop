+// How long the streaming thread waits for script. Frames come every 20 ms (audio) or so,
+// and one that arrives later than this is of no use to the other end anyway, while waiting
+// longer would stall the capture or playback queued up behind it.
+static constexpr Seconds frameTransformTimeout = 100_ms;
