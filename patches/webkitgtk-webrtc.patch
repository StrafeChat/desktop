+// Browsers name the synchronisation source of every track they send ("a=ssrc:N cname:…"
+// and "a=ssrc:N msid:…"), and an SFU uses those lines to tie arriving media to the track
+// that was published. webrtcbin only writes them when the media caps carry an ssrc, which
+// they do not before the packetizers exist, so the sections go out anonymous and the
+// publication never completes. Fill them in from the source that will do the sending.
+void GStreamerMediaEndpoint::announceOutgoingSSRCs(GstSDPMessage* sdp)
+{
+    unsigned totalMedias = gst_sdp_message_medias_len(sdp);
+    for (unsigned i = 0; i < totalMedias; i++) {
+        auto* media = const_cast<GstSDPMedia*>(gst_sdp_message_get_media(sdp, i));
+
+        bool isSending = false;
+        bool hasSSRC = false;
+        unsigned totalAttributes = gst_sdp_media_attributes_len(media);
+        for (unsigned j = 0; j < totalAttributes; j++) {
+            const auto* attribute = gst_sdp_media_get_attribute(media, j);
+            if (!g_strcmp0(attribute->key, "sendonly") || !g_strcmp0(attribute->key, "sendrecv"))
+                isSending = true;
+            else if (!g_strcmp0(attribute->key, "ssrc"))
+                hasSSRC = true;
+        }
+        if (!isSending || hasSSRC)
+            continue;
+
+        auto msid = String::fromUTF8(gst_sdp_media_get_attribute_val(media, "msid"));
+        if (msid.isEmpty())
+            continue;
+
+        for (auto& source : m_unlinkedOutgoingSources) {
+            if (!source)
+                continue;
+            const auto& track = source->track();
+            if (!track)
+                continue;
+            if (makeString(source->mediaStreamID(), ' ', track->id()) != msid)
+                continue;
+
+            auto ssrc = source->announcedSSRC();
+            if (!ssrc)
+                break;
+
+            auto cname = makeString(ssrc, "-cname"_s);
+            gst_sdp_media_add_attribute(media, "ssrc", makeString(ssrc, " cname:"_s, cname).utf8().data());
+            gst_sdp_media_add_attribute(media, "ssrc", makeString(ssrc, " msid:"_s, msid).utf8().data());
+            GST_DEBUG_OBJECT(m_pipeline.get(), "Announced ssrc %u for msid %s", ssrc, msid.utf8().data());
+            break;
+        }
+    }
+}
