+// Returns what should be sent on: the buffer passed in when no transform is installed, a new
+// buffer when script transformed the frame, null when script did not answer in time.
+GRefPtr<GstBuffer> GStreamerEncodedFrameTap::transformBuffer(GstBuffer* buffer)
+{
+    uint64_t token = 0;
+    {
+        Locker locker { m_callbackLock };
+        if (!m_callback)
+            return buffer;
+
+        GStreamerRtpTransformableFrame::StreamDescription description;
+        {
+            Locker descriptionLocker { m_descriptionLock };
+            description = m_description;
+        }
+
+        token = m_nextToken++;
+        {
+            Locker slotLocker { m_slotLock };
+            m_awaitedToken = token;
+            m_slotFilled = false;
+            m_slotBuffer = nullptr;
+        }
+
+        m_callback(GStreamerRtpTransformableFrame::create(GRefPtr<GstBuffer>(buffer), description, m_mediaType == MediaType::Audio, token));
+    }
+
+    GRefPtr<GstBuffer> transformed;
+    {
+        Locker locker { m_slotLock };
+        auto deadline = MonotonicTime::now() + frameTransformTimeout;
+        while (!m_slotFilled && m_awaitedToken == token) {
+            if (!m_slotCondition.waitUntil(m_slotLock, deadline))
+                break;
+        }
+        if (m_slotFilled && m_awaitedToken == token)
+            transformed = std::exchange(m_slotBuffer, GRefPtr<GstBuffer> { });
+        m_awaitedToken = 0;
+        m_slotFilled = false;
+        m_slotBuffer = nullptr;
+    }
+
+    if (!transformed) {
+        auto dropped = m_framesDropped.exchangeAdd(1) + 1;
+        if (dropped == 1 || !(dropped % 100))
+            GST_WARNING("Tap %p (%s side): %" PRIu64 " frames dropped, script did not transform them in time", this, m_side == Side::Sender ? "sender" : "receiver", dropped);
+        return nullptr;
+    }
+
+    auto framesOut = m_framesOut.exchangeAdd(1) + 1;
+    if (!(framesOut % 1000))
+        GST_DEBUG("Tap %p (%s side): %" PRIu64 " frames transformed, %" PRIu64 " dropped", this, m_side == Side::Sender ? "sender" : "receiver", framesOut, m_framesDropped.load());
+    return transformed;
+}
