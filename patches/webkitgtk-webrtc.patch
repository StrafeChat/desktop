+GRefPtr<GstBuffer> GStreamerRtpTransformableFrame::buildBuffer() const
+{
+    if (!m_buffer)
+        return nullptr;
+
+    auto buffer = adoptGRef(gst_buffer_new_allocate(nullptr, m_data.size(), nullptr));
+    if (!buffer)
+        return nullptr;
+
+    if (!m_data.isEmpty()) {
+        GstMappedBuffer mappedBuffer(buffer.get(), GST_MAP_WRITE);
+        if (!mappedBuffer)
