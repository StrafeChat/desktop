+// The pad to send an m-line's media through: webrtcbin binds a pad requested by the name
+// "sink_<m-line>" to the transceiver it has for that m-line, which is the transceiver this
+// description names and the one it will connect to its RTP session.
+//
+// Letting webrtcbin pick a pad instead (requestPad) gets one on a transceiver of its own,
+// which this description knows nothing about: it has no mid when the answer arrives, so
+// webrtcbin skips connecting its input stream ("transceiver not associated") and never
+// returns to it. The pad then stays blocked for the rest of the call, the queues behind it
+// fill, and the track sends nothing at all - while the signalling, ICE, and the server's
+// view of the publication all look healthy.
+//
+// No caps are passed with the request: webrtcbin refuses the pad when they do not intersect
+// the codec preferences the transceiver already carries, and the payload type picked for a
+// fresh sender is not the one that was negotiated.
+GRefPtr<GstPad> GStreamerMediaEndpoint::requestPadForMLine(unsigned mLineIndex, const GRefPtr<GstCaps>& allowedCaps, const String& mediaStreamID)
+{
+    auto padName = makeString("sink_"_s, mLineIndex);
+    auto sinkPad = adoptGRef(gst_element_request_pad_simple(m_webrtcBin.get(), padName.ascii().data()));
+    if (!sinkPad) {
+        GST_DEBUG_OBJECT(m_pipeline.get(), "webrtcbin has no sender pad to give for m-line %u, asking it to pick one", mLineIndex);
+        return requestPad(allowedCaps, mediaStreamID);
+    }
+
+    GST_DEBUG_OBJECT(m_pipeline.get(), "Sending m-line %u through %" GST_PTR_FORMAT, mLineIndex, sinkPad.get());
+    if (!mediaStreamID.isEmpty() && gstObjectHasProperty(sinkPad.get(), "msid"_s))
+        g_object_set(sinkPad.get(), "msid", mediaStreamID.ascii().data(), nullptr);
+
+    // Tell the transceiver what is actually going to come through this pad. Its preferences
+    // still describe what we offered, and an answer is free to renumber the payload type -
+    // which an SFU does - so the pad would otherwise advertise a format the packetizer never
+    // produces, the link would fail for want of a common format, and the source would push
+    // into nothing: the track sends silence with nothing in the logs but a stream error.
+    GRefPtr<GstWebRTCRTPTransceiver> transceiver;
+    g_object_get(sinkPad.get(), "transceiver", &transceiver.outPtr(), nullptr);
+    if (transceiver)
+        g_object_set(transceiver.get(), "codec-preferences", allowedCaps.get(), nullptr);
+    return sinkPad;
+}
+
+// The payload type this session already uses for a codec, taken from the transceivers that
+// have one. Numbering a codec the same way in every m-line is what browsers do, and it
+// keeps an answer from having to renumber ours - which would leave the sender packetizing
+// something the far end does not recognise.
+std::optional<int> GStreamerMediaEndpoint::payloadTypeForCodecInUse(StringView encodingName)
+{
+    std::optional<int> result;
+    auto wanted = encodingName.convertToASCIIUppercase();
+    forEachTransceiver(m_webrtcBin, [&](auto&& transceiver) -> bool {
+        GRefPtr<GstCaps> codecPreferences;
+        g_object_get(transceiver.get(), "codec-preferences", &codecPreferences.outPtr(), nullptr);
+        if (!codecPreferences)
+            return false;
+
+        for (unsigned i = 0; i < gst_caps_get_size(codecPreferences.get()); i++) {
+            auto* structure = gst_caps_get_structure(codecPreferences.get(), i);
+            auto name = gstStructureGetString(structure, "encoding-name"_s);
+            if (!name || name.convertToASCIIUppercase() != wanted)
+                continue;
+            if (auto payloadType = gstStructureGet<int>(structure, "payload"_s)) {
+                result = *payloadType;
+                return true;
+            }
+        }
+        return false;
+    });
+    if (result)
+        GST_DEBUG_OBJECT(m_pipeline.get(), "This session already carries %s as payload type %d", encodingName.utf8().data(), *result);
+    return result;
+}
