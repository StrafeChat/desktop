+GstPadProbeReturn GStreamerEncodedFrameTap::handleProbe(GstPadProbeInfo* info)
+{
+    // A buffer list would have to be taken apart and transformed frame by frame; neither an
+    // encoder nor a depayloader sends one, so there is nothing to take apart.
+    if (info->type & GST_PAD_PROBE_TYPE_BUFFER_LIST) [[unlikely]] {
+        GST_WARNING("Dropping a buffer list: encoded frames are transformed one at a time");
