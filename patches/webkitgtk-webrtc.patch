+// An answer settles what a sender actually sends, and it can differ from what we offered -
+// the payload type above all, which the other end is free to renumber. Hand each m-line's
+// choices to the transceiver that carries it; the outgoing source watching that transceiver
+// then rebuilds its packetizer for what was agreed. Without this a sender keeps packetizing
+// what we proposed, which the far end does not recognise, and the call carries no audio.
+void GStreamerMediaEndpoint::adoptNegotiatedCodecs(const GstSDPMessage* sdpMessage)
+{
+    unsigned totalMedias = gst_sdp_message_medias_len(sdpMessage);
+    for (unsigned i = 0; i < totalMedias; i++) {
+        const auto media = gst_sdp_message_get_media(sdpMessage, i);
+        auto mediaType = StringView::fromLatin1(gst_sdp_media_get_media(media));
+        if (mediaType != "audio"_s && mediaType != "video"_s)
+            continue;
+
+        auto caps = capsFromSDPMedia(media);
+        if (!caps || gst_caps_is_empty(caps.get()))
+            continue;
+
+        forEachTransceiver(m_webrtcBin, [&](auto&& transceiver) -> bool {
+            unsigned mLineIndex;
+            GstWebRTCRTPTransceiverDirection direction;
+            g_object_get(transceiver.get(), "mlineindex", &mLineIndex, "direction", &direction, nullptr);
+            if (mLineIndex != i)
+                return false;
+            if (direction != GST_WEBRTC_RTP_TRANSCEIVER_DIRECTION_SENDONLY && direction != GST_WEBRTC_RTP_TRANSCEIVER_DIRECTION_SENDRECV)
+                return true;
+
+            GST_DEBUG_OBJECT(m_pipeline.get(), "Handing the codecs agreed for m-line %u to %" GST_PTR_FORMAT, i, transceiver.get());
+            g_object_set(transceiver.get(), "codec-preferences", caps.get(), nullptr);
+            return true;
+        });
+    }
+}
