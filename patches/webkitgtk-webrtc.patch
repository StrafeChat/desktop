+    // Script was asked and did not answer in time. Sending the frame on as it stands would
+    // be sending it in the clear, which is the one thing a transform exists to prevent.
+    if (!transformed)
+        return GST_PAD_PROBE_DROP;
+
+    gst_buffer_unref(buffer);
+    GST_PAD_PROBE_INFO_DATA(info) = transformed.leakRef();
+    return GST_PAD_PROBE_OK;
+}
